# Discord SSO gate (meow-elite-club-portal) on list creation/editing only —
# see docs/portal-architecture.md in infra for the full cross-domain bridge
# flow. The read-only per-config dashboard below (`/{id}`,
# `/{id}/chart/...`) is intentionally left open: the UUID
# itself is the share link's access token, and gating it would break
# sharing a dashboard with someone outside the Discord allow-list.

location = / {
    auth_request /internal/zw-auth;
    auth_request_set $discord_avatar_url $upstream_http_x_discord_avatar_url;
    auth_request_set $discord_user_id $upstream_http_x_discord_user_id;
    error_page 401 = @zw_login;
    proxy_intercept_errors on;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $hotline_listing_host "{{ hotline_listing_container_name }}";
    proxy_pass http://$hotline_listing_host:{{ hotline_listing_http_port }}/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Discord-Avatar-Url $discord_avatar_url;
    proxy_set_header X-Discord-User-Id $discord_user_id;
}

location = /import {
    auth_request /internal/zw-auth;
    auth_request_set $discord_user_id $upstream_http_x_discord_user_id;
    error_page 401 = @zw_login;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $hotline_listing_host "{{ hotline_listing_container_name }}";
    proxy_pass http://$hotline_listing_host:{{ hotline_listing_http_port }}/import;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Discord-User-Id $discord_user_id;
}

# Ungated: just clears a cookie, nothing to protect — see app.py's /logout.
location = /logout {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $hotline_listing_host "{{ hotline_listing_container_name }}";
    proxy_pass http://$hotline_listing_host:{{ hotline_listing_http_port }}/logout;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location ~ ^/[^/]+/(edit|save|delete|claim)$ {
    auth_request /internal/zw-auth;
    auth_request_set $discord_avatar_url $upstream_http_x_discord_avatar_url;
    auth_request_set $discord_user_id $upstream_http_x_discord_user_id;
    error_page 401 = @zw_login;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $hotline_listing_host "{{ hotline_listing_container_name }}";
    proxy_pass http://$hotline_listing_host:{{ hotline_listing_http_port }};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Discord-Avatar-Url $discord_avatar_url;
    proxy_set_header X-Discord-User-Id $discord_user_id;
}

# Ungated: read-only dashboard view + chart data.
location / {
    proxy_intercept_errors on;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $hotline_listing_host "{{ hotline_listing_container_name }}";
    proxy_pass http://$hotline_listing_host:{{ hotline_listing_http_port }};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /internal/zw-auth {
    internal;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $meow_elite_club_portal_host "{{ meow_elite_club_portal_container_name }}";
    proxy_pass http://$meow_elite_club_portal_host:{{ meow_elite_club_portal_http_port }}/auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Service-Slug "{{ hotline_listing_service_slug }}";
}

location = /internal/bridge {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $meow_elite_club_portal_host "{{ meow_elite_club_portal_container_name }}";
    # proxy_pass targets a variable ($meow_elite_club_portal_host, for dynamic
    # DNS resolution), so nginx does NOT auto-forward the query string here —
    # $is_args$args must be explicit or the portal's ?ticket=... is dropped.
    proxy_pass http://$meow_elite_club_portal_host:{{ meow_elite_club_portal_http_port }}/bridge/consume$is_args$args;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_real_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie $http_cookie;
}

location @zw_login {
    return 302 https://meow-elite.club/login?next=$scheme://$host$request_uri;
}
